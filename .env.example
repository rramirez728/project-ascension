# USDA Food Data Central (optional — falls back to DEMO_KEY)
VITE_USDA_API_KEY=

# Supabase — use PROJECT URL only (NOT the /rest/v1 endpoint)
# Example: https://your-project-ref.supabase.co
VITE_SUPABASE_URL=
# Supabase → Project Settings → API → anon public key
VITE_SUPABASE_ANON_KEY=

# Server-only secrets. Do not prefix these with VITE_.
# Set them with: supabase secrets set OPENAI_API_KEY=... USDA_API_KEY=...
# OPENAI_API_KEY=
# USDA_API_KEY=
